{
  "name": "album-figurinhas-firebase-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "emulator": "firebase emulators:start --only firestore --project demo-album-figurinhas-2026 --config ../firebase.json",
    "seed:emulator": "node seed.mjs --project demo-album-figurinhas-2026 --emulator",
    "seed:emulator:once": "firebase emulators:exec --only firestore --project demo-album-figurinhas-2026 --config ../firebase.json \"node seed.mjs --project demo-album-figurinhas-2026 --emulator\"",
    "seed:production": "node seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-album-figurinhas-2026 --config ../firebase.json \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@google-cloud/firestore": "8.7.0",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0"
  }
}
