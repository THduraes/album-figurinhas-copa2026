rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if false;

      match /teams/{teamId} {
        allow read: if true;
        allow write: if false;

        match /players/{playerId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }
  }
}
